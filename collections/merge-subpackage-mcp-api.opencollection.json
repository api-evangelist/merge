{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounting subpackage_mcp API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "subpackage_mcp",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "MCP endpoint - list tools & call tool",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.merge.dev/api/api/v1/tool-packs/:tool_pack_id/registered-users/:registered_user_id/mcp/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "registered_user_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tool_pack_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "authenticated_only",
                "value": "",
                "type": "query",
                "description": "When true, only return tools for connectors the registered user has already authenticated, and hide per-connector `authenticate_*` tools."
              },
              {
                "name": "format",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Endpoint to list tools and call a tool. Use the `tools/list` method to retrieve available tools, and the `tools/call` method to execute a specific tool. Implements the JSON-RPC 2.0 MCP specification."
        }
      ]
    }
  ],
  "bundled": true
}